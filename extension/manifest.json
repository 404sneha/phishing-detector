{
  "manifest_version": 3,
  "name": "Phishing Detector",
  "version": "2.0",

  "permissions": ["tabs", "activeTab", "scripting"],

  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html"
  }
}